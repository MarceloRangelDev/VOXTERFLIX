# Garante que scripts shell mantenham quebra de linha LF mesmo ao clonar
# em uma maquina Windows configurada para converter para CRLF — um CRLF
# dentro de um script bash quebra o interpretador (/usr/bin/env bash).
setup.sh text eol=lf
*.sh text eol=lf

# Scripts do Windows usam CRLF nativamente.
*.bat text eol=crlf
