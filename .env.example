# ==========================================================================
# VoxterFlix — variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# NUNCA versione o arquivo ".env" (ele já está no .gitignore).
# ==========================================================================

# Chave secreta do Django. Gere uma nova para cada ambiente com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True apenas em desenvolvimento. Em produção, use False.
DEBUG=True

# Hosts permitidos, separados por vírgula.
ALLOWED_HOSTS=127.0.0.1,localhost

# --------------------------------------------------------------------------
# Banco de dados
# SQLite (padrão, não exige instalação de nada):
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (opcional, para produção):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/voxterflix

# --------------------------------------------------------------------------
# OMDb API (catálogo de filmes e séries) — obtenha uma chave gratuita em
# https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
OMDB_BASE_URL=https://www.omdbapi.com/
OMDB_TIMEOUT=10
OMDB_CACHE_TTL=21600

# --------------------------------------------------------------------------
# SuperFlixAPI (player de streaming). Sem esta variável, o restante da
# aplicação continua funcionando normalmente — apenas o player mostra uma
# mensagem informando que a integração não está configurada.
SUPERFLIX_API_BASE_URL=
SUPERFLIX_TIMEOUT=10

# --------------------------------------------------------------------------
# Resend (envio de e-mails transacionais) — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=VoxterFlix

# --------------------------------------------------------------------------
# Regras de negócio
MAX_PROFILES_PER_USER=5
LOGIN_RATE_LIMIT=3/15m

# URL pública do site (usada em e-mails). Em produção, use o domínio real.
SITE_URL=http://127.0.0.1:8000

# --------------------------------------------------------------------------
# Segurança de produção (só têm efeito quando DEBUG=False)
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
